# Local development. Copy to .env.local; `docker compose -f compose.dev.yaml
# up -d` starts PostgreSQL 18, a Keycloak with test users (password:
# backups-dev; the list is in compose.dev.yaml), an S3 storage and Mailpit.
# Every variable is described in docs/configuration.md.

# The web app's development server (npm run dev) on port 5173 passes /api
# and /- to the server on port 3000; sign in at http://localhost:5173.
APP_URL=http://localhost:5173
DATABASE_URL=postgres://backups:backups@localhost:55460/backups
# Development only; production: openssl rand -base64 32 (each)
AUTH_SECRET=development-secret-development-secret
ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQta2V5LWRldmVsb3BtZW50LWtleSE=

OIDC_ISSUER=http://localhost:8114/realms/backups
OIDC_CLIENT_ID=backups
OIDC_CLIENT_SECRET=backups-dev-client-secret
OIDC_PROVIDER_NAME=Keycloak

# Only admins sign in: by address, or by group (the groups claim).
ADMIN_EMAILS=ada@example.org
ADMIN_GROUPS=/backup-admins

NODE_ENV=development
RUN_MIGRATIONS=true
# Local copies of Google Drive, S3 buckets and Personio, and restic's cache.
DATA_DIR=.data
TZ=Europe/Berlin

# The target in the app (Settings > Target) for compose.dev.yaml's S3:
#   endpoint http://localhost:9114, region us-east-1, bucket backups,
#   access key backups, secret key backups-dev-secret
# Alerts (Settings > Notifications): SMTP localhost, port 1035, no security.

# Production with compose.yaml: new secrets, URLs and sign-in values above,
# and optionally the image to run (docs/deployment.md): latest (default) or
# sha-<commit>.
# BACKUP_IMAGE_TAG=latest
