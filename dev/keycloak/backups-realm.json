{
  "realm": "backups",
  "displayName": "Backup (development)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [
    {
      "name": "backup-admins",
      "path": "/backup-admins"
    },
    {
      "name": "staff",
      "path": "/staff"
    }
  ],
  "clients": [
    {
      "clientId": "backups",
      "name": "Backups (development)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "backups-dev-client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/oidc",
        "http://localhost:5173/api/auth/callback/oidc",
        "http://localhost:3060/api/auth/callback/oidc"
      ],
      "webOrigins": ["http://localhost:3000", "http://localhost:5173", "http://localhost:3060"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "ada",
      "enabled": true,
      "email": "ada@example.org",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Lovelace",
      "credentials": [
        {
          "type": "password",
          "value": "backups-dev",
          "temporary": false
        }
      ],
      "groups": ["/staff"]
    },
    {
      "username": "grace",
      "enabled": true,
      "email": "grace@example.org",
      "emailVerified": true,
      "firstName": "Grace",
      "lastName": "Hopper",
      "credentials": [
        {
          "type": "password",
          "value": "backups-dev",
          "temporary": false
        }
      ],
      "groups": ["/staff", "/backup-admins"]
    },
    {
      "username": "rita",
      "enabled": true,
      "email": "rita@example.org",
      "emailVerified": true,
      "firstName": "Rita",
      "lastName": "Levi",
      "credentials": [
        {
          "type": "password",
          "value": "backups-dev",
          "temporary": false
        }
      ],
      "groups": ["/staff"]
    }
  ]
}
